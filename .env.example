DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Blob storage. Two options, and step 1 runs on either:
#   LocalBlobs  -> SNAPSHOT_ROOT, no credentials, snapshots land on disk
#   S3Blobs     -> the four lines below; Supabase Storage speaks S3, so swapping
#                  to AWS/R2 later is those same four lines
BLOB_BACKEND=local          # local | s3 — use s3 wherever the disk is not durable
SNAPSHOT_ROOT=snapshots

S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=registerwatch-raw
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# A real contact (a URL and an inbox); values with <...> are rejected at startup.
# Avoid the word "monitoring": ACMA answers it with a health check instead of the register.
USER_AGENT=RegisterWatch/0.1 (gambling licence register tracking; +https://yourdomain/bot; you@yourdomain)
MIN_REFETCH_INTERVAL_H=20
LOG_LEVEL=INFO


# API (uv run registerwatch serve). INGEST_TOKEN guards POST /ingest/ukgc and is
# the value stored in Supabase Vault as registerwatch_ingest_token. Tokens shorter
# than 32 characters are refused at startup; make one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
PORT=8000
STALE_AFTER_H=26

# Per client a minute (bearer token, else address; each process counts on its
# own). 0 turns one off. A v1 statement running longer than the timeout is a 504.
RATE_LIMIT_READ_PER_MIN=600
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_INGEST_PER_MIN=10
READ_STATEMENT_TIMEOUT_MS=5000

# Read connections (a request waiting longer than the timeout for one is a 503).
# Ingest has its own 2, and the run lock 1 more: at most DB_POOL_MAX + 3 per process.
DB_POOL_MAX=10
DB_POOL_TIMEOUT_S=3

# Server (registerwatch serve, and the image). Processes, each with its own
# pools and rate-limit buckets.
WEB_CONCURRENCY=1
# On SIGTERM a running ingest finishes the register in hand, recording the rest
# as not started, and requests in flight finish. The server waits
# SHUTDOWN_GRACE_S + 5 s for them and is gone 4 s later whatever still runs:
# give the platform's stop timeout more than SHUTDOWN_GRACE_S + 10.
SHUTDOWN_GRACE_S=60
# Proxies whose X-Forwarded-For/-Proto are believed, so the client address (and
# its rate-limit bucket) is the real client's, and an answer over https carries
# Strict-Transport-Security. Addresses or networks, comma-separated, or * when
# nothing but the platform's proxy can reach the app.
FORWARDED_ALLOW_IPS=127.0.0.1
# Browser origins (scheme://host[:port], comma-separated) whose pages may read
# the API with GET, without cookies. Empty: no CORS at all; the API is for servers.
CORS_ALLOW_ORIGINS=
